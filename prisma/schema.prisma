generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ========================
// 사용자
// ========================
model User {
  id           String    @id @default(uuid())
  googleId     String    @unique
  email        String    @unique
  name         String
  profileImage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stories      Story[]
  chatRoom     ChatRoom?
}

// ========================
// 카테고리
// ========================
model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  order       Int     @default(0)

  // UI Metadata
  title       String  @default("")
  emoji       String  @default("📚")
  description String  @default("")
  colorClass  String  @default("text-stone-500")
  iconName    String  @default("book-open")

  stories Story[]
}

// ========================
// 스토리 (작품)
// ========================
model Story {
  id                   String    @id @default(uuid())
  title                String    @db.VarChar(100)
  seriesTitle          String?
  authorName           String    @db.VarChar(50)
  description          String    @db.VarChar(400)
  summary              String    @db.VarChar(4000)
  coverColor           String    @default("bg-stone-800")
  coverImage           String?   @db.VarChar(2048)
  backgroundImage      String?   @db.VarChar(2048)
  isOfficial           Boolean   @default(false)
  marketingTitle       String?
  marketingDescription String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])

  creatorId   String?
  creator     User?    @relation(fields: [creatorId], references: [id])

  characters  Character[]
  contents    StoryContent[]

  @@index([categoryId])
  @@index([createdAt])
}

// ========================
// 등장인물
// ========================
enum CharacterRole {
  주인공
  조연
}

model Character {
  id              String        @id @default(uuid())
  name            String        @db.VarChar(50)
  role            CharacterRole
  description     String        @db.VarChar(400)
  personality     String?       @db.VarChar(400)
  firstMessage    String?       @db.VarChar(100)
  profileImage    String?       @db.VarChar(2048)
  backgroundImage String?       @db.VarChar(2048)
  imageColor      String        @default("bg-stone-400")
  backgroundColor String        @default("bg-stone-900")
  voiceId         String?
  voiceSettings   Json?
  createdAt       DateTime      @default(now())

  storyId     String
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  chatRoomCharacters ChatRoomCharacter[]

  @@unique([storyId, name])
  @@index([storyId])
}

// ========================
// 원작 텍스트 청크 (RAG)
// ========================
model StoryContent {
  id         String                       @id @default(uuid())
  content    String                       @db.Text
  chunkIndex Int
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime @default(now())

  storyId    String
  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, chunkIndex])
}

// ========================
// 채팅방 (사용자당 1개)
// ========================
model ChatRoom {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  characters ChatRoomCharacter[]
}

// ========================
// 채팅방-캐릭터 연결
// ========================
model ChatRoomCharacter {
  id        String   @id @default(uuid())
  addedAt   DateTime @default(now())

  chatRoomId  String
  chatRoom    ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  messages    ChatMessage[]

  @@unique([chatRoomId, characterId])
  @@index([chatRoomId])
}

// ========================
// 채팅 메시지
// ========================
model ChatMessage {
  id        String   @id @default(uuid())
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  chatRoomCharacterId String
  chatRoomCharacter   ChatRoomCharacter @relation(fields: [chatRoomCharacterId], references: [id], onDelete: Cascade)

  @@index([chatRoomCharacterId, createdAt])
}
